<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/w_crest"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@string/widget_crest"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/w_league"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#9CB1A5"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_big_position"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:includeFontPadding="false"
        android:textColor="#E9F1EC"
        android:textSize="40sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_points"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#9CB1A5"
        android:textSize="11sp" />

    <ImageView
        android:id="@+id/w_form"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginTop="6dp"
        android:adjustViewBounds="true"
        android:contentDescription="@string/widget_form"
        android:scaleType="fitStart" />
</LinearLayout>
