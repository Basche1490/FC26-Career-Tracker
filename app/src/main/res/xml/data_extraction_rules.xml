<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup rules. Only the career saves (files/saves) are backed up, so a new phone gets the
  careers back. Device settings and the encrypted AI key are deliberately left out: the key could not be
  decrypted on another device anyway.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="saves" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="saves" />
    </device-transfer>
</data-extraction-rules>
